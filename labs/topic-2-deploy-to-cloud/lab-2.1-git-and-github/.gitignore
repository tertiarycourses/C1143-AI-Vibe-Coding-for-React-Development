# --- Dependencies -----------------------------------------------------------
# Reinstallable from package.json + package-lock.json. Huge, and machine-specific.
node_modules

# --- Build output -----------------------------------------------------------
# Generated by `npm run build`. Regenerated any time; never a source of truth.
dist
dist-ssr

# --- Secrets & local env ----------------------------------------------------
# Real passwords live here — DATABASE_URL and JWT_SECRET arrive in Topic 5.
# NEVER commit this file. A credential in git history is permanent.
.env
.env.local
.env.*.local
*.local

# --- Vercel -----------------------------------------------------------------
# The local link to your Vercel project, written by `vercel link` / `vercel dev`.
.vercel

# --- Logs -------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Editor / OS junk -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?
