# Copy this file to .env.local and paste in your own values.
# .env.local is git-ignored. Never commit real secrets.
#
# ===========================================================================
# READ THIS BEFORE YOU ADD ANY VARIABLE
#
# Vite splits environment variables into two worlds:
#
#   VITE_SOMETHING   -> COMPILED INTO THE BROWSER BUNDLE. Vite finds
#                       import.meta.env.VITE_SOMETHING in your source and
#                       substitutes the value straight into the .js file it
#                       ships. Anyone can open devtools — or just read
#                       dist/assets/index-*.js — and see it. A VITE_ variable is
#                       PUBLIC. Always. There is no exception.
#
#   SOMETHING        -> stays on the SERVER. Vite never touches it. Only code
#                       running in Node (our api/ serverless functions) can read
#                       it, via process.env.SOMETHING.
#
# NEITHER variable below has a VITE_ prefix, and that is the whole point of the
# three-tier architecture:
#
#     React (browser) --fetch--> /api/* (serverless) --sql--> Neon Postgres
#
# The browser NEVER connects to Postgres and holds no credentials. It calls our
# own /api/* URLs. Only the serverless functions hold DATABASE_URL, so the
# database password is never inside anything a visitor downloads.
#
# If you ever "fix" a connection error by renaming DATABASE_URL to
# VITE_DATABASE_URL, you have just published your database password — with full
# read AND write access — to every visitor of your site. Do not do it. No VITE_
# variable is ever a safe place for a password.
# ===========================================================================

# The Neon Postgres connection string. Server-side ONLY (no VITE_ prefix!).
# Find it in the Neon Console -> your project -> Connect.
# Locally, `vercel dev` reads this from .env.local and passes it to api/.
# In production, set it in Vercel -> Project -> Settings -> Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# The key our API signs and verifies login tokens (JWTs) with. Server-side ONLY.
# Anyone who knows this value can mint a valid token for ANY user and sign in as
# them, so treat it exactly like a password. Generate a real one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me
